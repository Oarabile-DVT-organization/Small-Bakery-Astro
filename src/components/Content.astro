---
import BackerImage from "../assets/Marketplace-amico.svg"
import OtherImage from "../assets/Baker-cuate.svg"
---
<section class="m-[5%]">
    <div class="flex flex-wrap justify-center items-center">
        <div class="w-[35%] mr-[3%]">
            <img 
                src={BackerImage.src}
                alt=""
                class="w-[100%]"
            >
        </div>
        <div>
            <h3 class="text-4xl font-bold">Always here for you</h3>
            <p class="mt-[3.5%]">This is the content next to the image</p>
            <button class="btn btn-primary float-right mt-5" style={{background:"#FFC100", border:"#FFC100"}}>Menu</button>
        </div>
    </div>
</section>

<section class="mt-[2%]">
    <div class="flex justify-center items-center">
        <div class="mr-[3%]"> 
            <h3 class="text-4xl font-bold">Always here for you</h3>
            <p class="mt-[3.5%]">This is the content next to the image</p>
            <button class="btn btn-primary mt-5" style={{background:"#FFC100", border:"#FFC100"}}>Menu</button>
        </div>
        <div class="w-[35%]">
            <img 
                src={OtherImage.src}
                alt=""
                class="w-[100%]"
            >
        </div>
    </div>
</section>
